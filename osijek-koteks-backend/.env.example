MONGODB_URI=
JWT_SECRET=
ENABLE_PUBLIC_REGISTRATION=false

# HMAC clients allowed to call this backend. Reconciliation clients need GET
# access to /api/integrations/delivery-note-sync-state and a valid actorUserId.
# Keep the array empty until a client is deliberately configured.
SERVICE_AUTH_CLIENTS_JSON=[]
SERVICE_AUTH_TIMESTAMP_TOLERANCE_SECONDS=300
SERVICE_AUTH_NONCE_TTL_SECONDS=600

# Delivery-note push targets. Each target has independent credentials and
# delivery progress. A disabled target receives no new outbox delivery entries.
DELIVERY_NOTE_TARGET_PRODUCTION_ENABLED=false
DELIVERY_NOTE_TARGET_PRODUCTION_URL=
DELIVERY_NOTE_TARGET_PRODUCTION_CLIENT_ID=
DELIVERY_NOTE_TARGET_PRODUCTION_SECRET=

DELIVERY_NOTE_TARGET_STAGING_ENABLED=false
DELIVERY_NOTE_TARGET_STAGING_URL=
DELIVERY_NOTE_TARGET_STAGING_CLIENT_ID=
DELIVERY_NOTE_TARGET_STAGING_SECRET=

# Delivery worker timing. Values are milliseconds except batch size.
DELIVERY_NOTE_WORKER_POLL_INTERVAL_MS=5000
DELIVERY_NOTE_WORKER_BATCH_SIZE=25
DELIVERY_NOTE_WORKER_RETRY_BASE_MS=5000
DELIVERY_NOTE_WORKER_RETRY_MAX_MS=900000
DELIVERY_NOTE_WORKER_LEASE_MS=30000
DELIVERY_NOTE_WORKER_HTTP_TIMEOUT_MS=15000
